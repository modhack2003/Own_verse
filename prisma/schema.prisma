datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// NOTE: every field added to an existing model is optional so documents that
// were created before it existed keep loading.

model PersonalData {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  title     String
  bio       String
  github    String
  linkedin  String
  email     String
  resumeUrl String
  avatarUrl String?
  location  String?
  /// HackerOne / Bugcrowd / Intigriti … profile URLs shown in the bug bounty sections
  bountyProfiles String[]
}

model Project {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  description String
  tags        String[]
  link        String?
}

model Skill {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  languages String[]
  tools     String[]
  areas     String[]
}

model Certificate {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  name   String
  issuer String
  year   Int
  url    String?
}

model Education {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  institution String
  degree      String
  duration    String
}

model Experience {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  company     String
  role        String
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  current     Boolean   @default(false)
  description String?
  source      String? // "manual" | "linkedin"
  createdAt   DateTime  @default(now())
}

model CtfEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  organizer  String
  date       DateTime
  placement  String?
  team       String?
  writeupUrl String?
  categories String[]
  points     Int?
}

model GitHubRepository {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  githubId        Int      @unique // GitHub repository ID
  name            String
  fullName        String   @unique // owner/repo format
  description     String?
  htmlUrl         String
  cloneUrl        String
  language        String?
  topics          String[] // GitHub topics/tags
  stargazersCount Int      @default(0)
  forksCount      Int      @default(0)
  createdAt       DateTime
  updatedAt       DateTime
  pushedAt        DateTime
  size            Int
  defaultBranch   String
  visibility      String // public, private
  archived        Boolean  @default(false)
  disabled        Boolean  @default(false)
  homepage        String?
  license         String?
  fork            Boolean?
  readmeCheckedAt DateTime?
  readmeExcerpt   String? // first paragraph of the README, used when there is no description

  // Portfolio display settings
  displayInPortfolio Boolean  @default(false)
  customTitle        String? // Override repository name for display
  customDescription  String? // Override repository description for display
  customTags         String[] // Custom tags for portfolio display
  displayOrder       Int? // Pin position (lower = first); null = sorted by latest activity

  // Metadata
  syncedAt    DateTime @default(now())
  lastChecked DateTime @default(now())
}

model BlogPost {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String    @unique
  excerpt     String
  content     String
  tags        String[]
  published   Boolean   @default(false)
  publishedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

/// A reported vulnerability shown in the public Hall of Fame.
/// When privateProgram is true the program name and link never leave the server.
model BountyFinding {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  title          String
  program        String
  privateProgram Boolean   @default(false)
  platform       String?
  severity       String    @default("medium") // critical | high | medium | low | info
  vulnType       String?
  bounty         Int? // whole currency units
  currency       String?
  cve            String?
  hallOfFame     Boolean   @default(false)
  date           DateTime?
  link           String?
  description    String?
  createdAt      DateTime  @default(now())
}

/// Incoming work: VAPT requests ("vapt") and bug bounty program invites ("bounty").
model Engagement {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  kind        String // vapt | bounty
  status      String   @default("new") // new | reviewing | accepted | completed | declined
  name        String
  email       String
  company     String?
  message     String
  // VAPT request
  services    String[] // web | api | mobile | network | cloud | code
  target      String?
  timeline    String?
  budget      String?
  nda         Boolean  @default(false)
  authorized  Boolean  @default(false)
  // Bug bounty invite
  programUrl  String?
  platform    String?
  programType String? // private | public | vdp | event
  rewards     String?
  // Admin only
  notes       String?
  ipHash      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, createdAt])
  @@index([ipHash, createdAt])
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  subject   String
  message   String
  read      Boolean  @default(false)
  ipHash    String?
  createdAt DateTime @default(now())

  @@index([ipHash, createdAt])
}

// ---------------------------------------------------------------------------
// Admin security
// ---------------------------------------------------------------------------

/// Singleton holding the hashed admin PIN once it has been changed from the
/// dashboard. While this document does not exist the ADMIN_PIN env var is used.
model AdminCredential {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique @default("admin")
  pinHash   String
  updatedAt DateTime @updatedAt
}

/// Server-side admin sessions. Only a SHA-256 hash of the cookie token is stored.
model AdminSession {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  ip         String?
  userAgent  String?
}

/// Every admin login attempt — used for lockouts and the login history.
model LoginAttempt {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ip        String
  success   Boolean
  userAgent String?
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
  @@index([createdAt])
}

/// Shared transaction guard: one document per throttle, independent of server instance.
model ThrottleGuard {
  id      String @id @map("_id")
  version Int    @default(0)
}

/// Singleton sync lease and last successful refresh, shared across instances.
model GitHubSyncState {
  id          String    @id @map("_id")
  username    String?
  lastSuccess DateTime?
  lastAttempt DateTime?
  lastError   String?
  lockedUntil DateTime?
  lockToken   String?
}

/// Scheduled Security Insights settings and shared import lease.
model InsightSyncState {
  id           String @id @map("_id")
  enabled      Boolean @default(true)
  autoPublish  Boolean @default(true)
  publishingMigratedAt DateTime?
  lastSuccess  DateTime?
  lastAttempt  DateTime?
  lastError    String?
  lockedUntil  DateTime?
  lockToken    String?
  backfilledAt DateTime?
  lastCreated  Int @default(0)
}

/// Durable deduplication, including posts deleted by an editor.
model InsightImport {
  id         String @id @map("_id")
  postSlug   String
  sourceDate DateTime
  importedAt DateTime @default(now())
  backfill   Boolean @default(false)
}

/// Shared site-wide playback settings; public visitors can only mute their theme.
model SiteAudioConfig {
  id                 String @id @map("_id")
  music              Float @default(0.75)
  dialogue           Float @default(1)
  effects            Float @default(0.95)
  randomDialogue     Boolean @default(true)
  intervalSeconds    Int @default(20)
  fadeSeconds        Float @default(4)
  enabledDialogueIds String[]
}
